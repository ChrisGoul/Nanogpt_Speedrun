# Copy to `.env` (which is gitignored — NEVER commit; the repo is public) and fill in.
# Used by runpod_ctl.py to deploy training pods.

RUNPOD_API_KEY=            # RunPod dashboard -> Settings -> API Keys (read/write)
NETWORK_VOLUME_ID=         # RunPod -> Storage -> your network volume -> its id
HF_TOKEN=hf_               # huggingface.co -> Settings -> Access Tokens (write)
HF_USER=chgoul3            # your HF username; models land at HF_USER/<run-name>
REPO_URL=https://github.com/ChrisGoul/Nanogpt_Speedrun
IMAGE=runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04
